# ==============================================================================
# PetSpotR Non-Secret Environment Template (.env.example)
#
# This file documents all environment variables used across the five PetSpotR
# microservices (web-frontend, lostpet-service, foundpet-service, pet-matcher,
# notification-service).
#
# DO NOT store real credentials, production API keys, or production secrets here.
# For local development and testing, copy this file to `.env` or set variables
# in your local shell / docker-compose environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Common Operational & Environment Settings
# ------------------------------------------------------------------------------

# Operational runtime environment tier.
# Options: development, local-emulator, staging, production.
# In staging and production, missing required variables or placeholder values trigger fail-fast validation.
# Default: development
PETSPOTR_ENV=development

# HTTP server listen port.
# Port must be a numeric integer between 1 and 65535.
# In local multi-service setups, typical ports are:
#   8080 - lostpet-service
#   8081 - foundpet-service
#   8082 - web-frontend
#   8083 - pet-matcher
#   8084 - notification-service
# Default: 8080
PORT=8080

# Google Cloud Platform project ID.
# Required in staging and production.
# In development/emulator modes, defaults to "petspotr-local".
# Default: petspotr-local
GOOGLE_CLOUD_PROJECT=petspotr-local

# Firestore database ID.
# Default: (default)
FIRESTORE_DATABASE_ID=(default)

# ------------------------------------------------------------------------------
# 2. Local Google Cloud Emulators (Development & Integration Testing)
# ------------------------------------------------------------------------------

# Host and port of the Firestore emulator.
# Permitted only in development and local-emulator environments; forbidden in production.
# Default: localhost:8085
FIRESTORE_EMULATOR_HOST=localhost:8085

# Host and port of the Google Cloud Pub/Sub emulator.
# Permitted only in development and local-emulator environments; forbidden in production.
# Default: localhost:8086
PUBSUB_EMULATOR_HOST=localhost:8086

# HTTP endpoint of the Google Cloud Storage emulator.
# Permitted only in development and local-emulator environments; forbidden in production.
# Default: http://localhost:9023
STORAGE_EMULATOR_HOST=http://localhost:9023

# Host and port of the Firebase Authentication emulator.
# Default: localhost:9099
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# ------------------------------------------------------------------------------
# 3. Cloud Storage Configuration
# ------------------------------------------------------------------------------

# Cloud Storage bucket name for private pet report images.
# Aliases: STORAGE_BUCKET_NAME, PET_IMAGES_BUCKET, PETSPOTR_IMAGE_BUCKET.
# Required in staging and production; defaults to local bucket in development.
# Default: petspotr-local-petimages
STORAGE_BUCKET_NAME=petspotr-local-petimages

# ------------------------------------------------------------------------------
# 4. Ollama & Gemma AI Model Configuration (pet-matcher)
# ------------------------------------------------------------------------------

# Base URL of the Ollama server for Gemma visual feature extraction.
# Default: http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# Ollama model tag used for multi-modal pet feature extraction.
# Default: gemma4
OLLAMA_MODEL=gemma4

# ------------------------------------------------------------------------------
# 5. Pub/Sub Topics & Subscriptions
# ------------------------------------------------------------------------------

# Topic name where lost-pet events are published by lostpet-service.
# Default: lost-pets
LOST_PET_TOPIC=lost-pets

# Topic name where found-pet events are published by foundpet-service.
# Default: found-pets
FOUND_PET_TOPIC=found-pets

# Topic name where match results are published by pet-matcher.
# Default: pet-matches
MATCH_TOPIC=pet-matches

# Primary push subscription path received by pet-matcher or notification-service.
# In GCP environments, this must match the fully qualified Cloud Run subscription path.
# Default (dev): projects/petspotr-local/subscriptions/found-pet-matcher
PUBSUB_PUSH_SUBSCRIPTION=projects/petspotr-local/subscriptions/found-pet-matcher

# Secondary push subscription path for lost-pet processing.
# Must be distinct from PUBSUB_PUSH_SUBSCRIPTION.
# Default (dev): projects/petspotr-local/subscriptions/lost-pet-matcher-analysis
PUBSUB_LOST_SUBSCRIPTION=projects/petspotr-local/subscriptions/lost-pet-matcher-analysis

# Expected service account email for verifying OIDC push tokens in staging/production.
# Forbidden in local-emulator/development.
# Default: unset in dev
# PUBSUB_PUSH_SERVICE_ACCOUNT=pubsub-invoker@petspotr.iam.gserviceaccount.com

# Static shared token for authenticating push deliveries in development and emulator modes.
# Forbidden in staging and production environments.
# Default: petspotr-local-push
PUBSUB_PUSH_DEV_TOKEN=petspotr-local-push

# ------------------------------------------------------------------------------
# 6. Web Frontend & Identity Platform Configuration
# ------------------------------------------------------------------------------

# Secret key used for signing and securing web session cookies.
# Required in production; defaults to safe local dummy key in development.
# Default: local-development-session-secret-change-in-production-32chars
SESSION_SECRET=local-development-session-secret-change-in-production-32chars

# Name of the HTTP cookie storing the user session token.
# Default: petspotr_session
SESSION_COOKIE_NAME=petspotr_session

# Identity authentication mode.
# Options: disabled, local-emulator, gcp.
# Default: disabled
PETSPOTR_IDENTITY_MODE=disabled

# Identity Platform / Firebase Web Client API key (public identifier, not secret).
# Default: unset
PETSPOTR_IDENTITY_WEB_API_KEY=

# Identity Platform / Firebase Web Auth Domain.
# Default: unset
PETSPOTR_IDENTITY_WEB_AUTH_DOMAIN=

# Identity Platform Web Project ID.
# Default: unset
PETSPOTR_IDENTITY_WEB_PROJECT_ID=

# Identity Platform local emulator URL.
# Must be an HTTP loopback origin when PETSPOTR_IDENTITY_MODE=local-emulator.
# Default: http://localhost:9099
PETSPOTR_IDENTITY_WEB_EMULATOR_URL=http://localhost:9099

# ------------------------------------------------------------------------------
# 7. Rate Limiting Configuration
# ------------------------------------------------------------------------------

# Enable or disable request rate limiting across public API endpoints.
# Options: true, false.
# Default: false
RATE_LIMIT_ENABLED=false

# Maximum allowed requests per minute per IP address.
# Default: 60
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Burst request capacity allowed beyond the rate limit.
# Default: 20
RATE_LIMIT_BURST=20

# ------------------------------------------------------------------------------
# 8. Notification Service Providers (notification-service)
# ------------------------------------------------------------------------------

# --- Email Provider (SendGrid) ---
# SendGrid API key for delivering email alerts to pet owners.
# In development, unset keys gracefully fall back to the logging email provider.
# Required in production if SendGrid is the selected notification channel.
SENDGRID_API_KEY=

# From address for outgoing notification emails.
# Default: alerts@petspotr.io
SENDGRID_FROM_EMAIL=alerts@petspotr.io

# --- SMS Provider (Twilio) ---
# Twilio Account SID for sending SMS text alerts.
# In development, unset credentials fall back to the logging SMS provider.
TWILIO_ACCOUNT_SID=

# Twilio Auth Token.
TWILIO_AUTH_TOKEN=

# Outgoing phone number configured in Twilio (E.164 format, e.g. +15551234567).
TWILIO_FROM_NUMBER=

# Default country calling code for formatting domestic phone numbers.
# Default: +1
SMS_DEFAULT_COUNTRY_CODE=+1

# --- Web Push Provider (VAPID) ---
# VAPID public key for Web Push notifications.
VAPID_PUBLIC_KEY=

# VAPID private key for signing Web Push notifications.
VAPID_PRIVATE_KEY=

# Contact URI or mailto address embedded into VAPID authorization headers.
# Default: mailto:alerts@petspotr.io
VAPID_SUBJECT=mailto:alerts@petspotr.io

# ------------------------------------------------------------------------------
# 9. Firestore Collections (lostpet-service & foundpet-service)
# ------------------------------------------------------------------------------

# Firestore collection for lost-pet reports.
# Default: lost_pets
LOST_PET_COLLECTION=lost_pets

# Firestore collection for lost-pet outbox entries.
# Default: lost_pets_outbox
LOST_PET_OUTBOX_COLLECTION=lost_pets_outbox

# Firestore collection for found-pet reports.
# Default: found_pets
FOUND_PET_COLLECTION=found_pets

# Firestore collection for found-pet outbox entries.
# Default: found_pets_outbox
FOUND_PET_OUTBOX_COLLECTION=found_pets_outbox
