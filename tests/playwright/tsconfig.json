{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "noEmit": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "playwright.config.ts",
    "e2e/**/*.ts",
    "unit/**/*.ts",
    "browser-globals.d.ts"
  ]
}
